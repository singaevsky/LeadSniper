# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uyezdny_konditer
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_32_characters_long
SALT_ROUNDS=10

# API Configuration
CORS_ORIGIN=http://localhost:3000

# Python Service Configuration
PYTHON_SERVICE_API_KEY=your_python_service_api_key

# Payment Gateway Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Cloud Storage Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Monitoring Configuration
GRAFANA_ADMIN_PASSWORD=admin_password

# External APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
YANDEX_GEOCODER_API_KEY=your_yandex_geocoder_api_key

# Development settings
NODE_ENV=development
ENVIRONMENT=development

# Feature flags
ENABLE_AI_RECOMMENDATIONS=false
ENABLE_WHOLESALE_BUYING=true
ENABLE_SUBSCRIPTIONS=false